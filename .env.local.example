# Copier ce fichier en .env.local et renseigner les vraies clés.
# .env.local est ignoré par git (voir .gitignore) : ne jamais commiter de vraies clés.

# Clé publiable Stripe (exposée au navigateur, préfixe NEXT_PUBLIC_ obligatoire)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Clé secrète Stripe (serveur uniquement, ne jamais préfixer par NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_...

# Configuration Firebase (console Firebase > Paramètres du projet > Général > Vos applications)
# Ces valeurs ne sont pas des secrets : elles sont conçues pour être exposées au navigateur.
NEXT_PUBLIC_FIREBASE_API_KEY=...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=...
NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=...
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
NEXT_PUBLIC_FIREBASE_APP_ID=...
